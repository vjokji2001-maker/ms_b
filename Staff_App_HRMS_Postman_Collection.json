            "description": "Returns company holidays assigned to this employee's calendar."
          },
          "response": []
        },
        {
          "name": "3. Weekly Off Days",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "clinicid",
                "value": "{{clinicid}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/roster/weekly-off?empId={{empId}}",
              "host": ["{{baseUrl}}"],
              "path": ["roster", "weekly-off"],
              "query": [
                {
                  "key": "empId",
                  "value": "{{empId}}"
                }
              ]
            },
            "description": "Returns list of recurring weekly off days (e.g. SUNDAY, SATURDAY)."
          },
          "response": []
        }
      ]
    },
